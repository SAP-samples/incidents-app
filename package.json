{
  "name": "incident-feedback-service",
  "version": "1.0.0",
  "description": "CAP microservice for incident feedback and ratings",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2.2.0",
    "@cap-js/telemetry": "latest",
    "@grpc/grpc-js": "^1.12.6",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.57.1",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.57.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.57.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.57.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.57.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.57.1",
    "@opentelemetry/host-metrics": "^0.36",
    "@opentelemetry/sdk-logs": "0.57.1",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap-cloud-sdk/util": "^4",
    "@sap/cds": "9",
    "@sap/fesr-to-otel-js": "https://73555000100200018064.npmsrv.cdn.repositories.cloud.sap/@sap/fesr-to-otel-js/-/fesr-to-otel-js-1.5.13.tgz",
    "@sap/hana-client": "^2.26.18",
    "@sap/opentelemetry-exporter-for-sap-cloud-logging": "^0.4.0",
    "@sap/xotel-agent-ext-js": "https://73555000100200018064.npmsrv.cdn.repositories.cloud.sap/@sap/xotel-agent-ext-js/-/xotel-agent-ext-js-1.5.30.tgz",
    "@sap/xssec": "^4",
    "cf-nodejs-logging-support": "7.5.0-beta.0",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "latest",
    "@sap/cds-dk": "latest",
    "cds-plugin-ui5": "latest"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-feedback": "cds watch --open com.sap.feedback/index.html?sap-ui-xx-viewCache=false --livereload false",
    "build": "cds build --production"
  },
  "sapux": [
    "app/feedback",
    "app/feedback"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "[production]": {
          "kind": "hana"
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": "xsuaa",
        "telemetry": {
          "kind": "to-cloud-logging"
        }
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  }
}
