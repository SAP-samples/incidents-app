{
  "_version": "1.76.0",
  "sap.app": {
    "id": "com.sap.feedback",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.18.7",
      "toolsId": "d8607aee-424a-43d4-aa9b-320628da328c"
    },
    "dataSources": {
      "mainService": {
        "uri": "odata/v4/feedback/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "feedback-display": {
          "semanticObject": "feedback",
          "action": "display",
          "title": "{{feedback-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.140.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.sap.feedback.i18n.i18n",
          "supportedLocales": ["", "en"],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "IncidentsForFeedbackList",
          "target": "IncidentsForFeedbackList"
        },
        {
          "pattern": "IncidentsForFeedback({key}):?query:",
          "name": "IncidentsForFeedbackObjectPage",
          "target": "IncidentsForFeedbackObjectPage"
        }
      ],
      "targets": {
        "IncidentsForFeedbackList": {
          "type": "Component",
          "id": "IncidentsForFeedbackList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/IncidentsForFeedback",
              "variantManagement": "Page",
              "navigation": {
                "IncidentsForFeedback": {
                  "detail": {
                    "route": "IncidentsForFeedbackObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "initialLoad": true,
              "filterSettings": {
                "enableFilterBar": true,
                "filter": {
                  "feedbackProvided": false
                }
              }
            }
          }
        },
        "IncidentsForFeedbackObjectPage": {
          "type": "Component",
          "id": "IncidentsForFeedbackObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": true,
              "contextPath": "/IncidentsForFeedback",
              "content": {
                "body": {
                  "sections": {
                    "FeedbackFacet": {
                      "visible": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
    "public": true,
    "service": "incidentfeedbackservice.service"
  }
}
